# Domaine servi par Traefik (front sur /, backend sur /api)
DOMAIN=worldofscans.example.com
# Email utilisé pour les certificats Let's Encrypt
ACME_EMAIL=you@example.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wos
# Port loopback pour le dev local. À changer si un Postgres tourne déjà sur ta machine.
POSTGRES_PORT=5432

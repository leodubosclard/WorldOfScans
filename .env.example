# Domaine servi par Traefik (front sur /, backend sur /api)
DOMAIN=worldofscans.example.com
# Email utilisé pour les certificats Let's Encrypt (Traefik embarqué uniquement)
ACME_EMAIL=you@example.com

# --- Uniquement si un Traefik tourne déjà ailleurs sur le serveur ---
# Voir docker-compose.external-traefik.yml. Ces noms doivent correspondre EXACTEMENT
# à ceux de ton Traefik : avec un certResolver inconnu, Traefik n'échoue pas, il sert
# son certificat auto-signé (navigateur en alerte et service worker qui ne s'enregistre pas).
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=le

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wos
# Port loopback pour le dev local. À changer si un Postgres tourne déjà sur ta machine.
POSTGRES_PORT=5432
